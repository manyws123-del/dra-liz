<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Mi Página Web</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #111;
      color: white;
      padding: 20px;
      text-align: center;
    }

    nav {
      margin-top: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 15px;
    }

    .hero {
      height: 500px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      background: white;
      padding: 30px;
    }

    .hero h1 {
      font-size: 50px;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 20px;
      max-width: 600px;
    }

    .boton {
      margin-top: 30px;
      padding: 15px 30px;
      background: #111;
      color: white;
      text-decoration: none;
      border-radius: 8px;
    }

    section {
      padding: 70px 10%;
      text-align: center;
    }

    footer {
      background: #111;
      color: white;
      text-align: center;
      padding: 25px;
    }
  </style>
</head>

<body>

<header>
  <h2>MI EMPRESA</h2>

  <nav>
    <a href="#inicio">Inicio</a>
    <a href="#nosotros">Nosotros</a>
    <a href="#contacto">Contacto</a>
  </nav>
</header>

<section class="hero" id="inicio">
  <h1>Bienvenido</h1>

  <p>
    Esta es mi página web creada desde cero y publicada gratuitamente con GitHub Pages.
  </p>

  <a href="#contacto" class="boton">
    Contactar
  </a>
</section>

<section id="nosotros">
  <h2>Sobre Nosotros</h2>
  <br>
  <p>
    Aquí puedes agregar información sobre tu negocio, servicios o proyecto.
  </p>
</section>

<section id="contacto">
  <h2>Contacto</h2>
  <br>
  <p>WhatsApp: +52 XXX XXX XXXX</p>
</section>

<footer>
  © 2026 Mi Empresa
</footer>

</body>
</html>
